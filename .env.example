# TradeLocker API Credentials
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_USERNAME=your_tradelocker_email@example.com
TL_PASSWORD=your_tradelocker_password_here
TL_SERVER=Demo

# Strategy & Risk Parameters
SYMBOL=XAUUSD
MAX_LOSS_DOLLARS=50.0
POSITION_QTY=0.10
HARD_DAILY_LOSS_LIMIT=125.0
POLL_INTERVAL_SECONDS=60

# Institutional Fine-Tunes
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here
DISCORD_USER=Trapquincyjones
MAX_ALLOWED_SPREAD=1.50
SESSION_FILTER_ENABLED=true
NEWS_GUARD_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
