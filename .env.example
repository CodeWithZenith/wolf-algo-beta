# =========================================================
# Wolf Algo — Beta Release Configuration Template (.env.example)
# =========================================================

# TradeLocker API Credentials (Fill in your own credentials)
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_USERNAME=your_tradelocker_email@example.com
TL_PASSWORD=your_tradelocker_password_here
TL_SERVER=Demo

# Instrument & Risk Management Parameters
SYMBOL=XAUUSD
MAX_LOSS_DOLLARS=50.0            # Strict $50 max dollar loss per trade
POSITION_QTY=0.10                # 0.10 lots (10 oz Gold)
HARD_DAILY_LOSS_LIMIT=125.0      # Hard daily loss circuit breaker ($125 cap)
POLL_INTERVAL_SECONDS=300        # 5-minute continuous evaluation loop

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
